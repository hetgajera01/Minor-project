{
  "name": "agri-sathi-backend",
  "version": "1.0.0",
  "description": "Backend for Agri-Sathi MERN application",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "kill-port": "powershell -Command \"$proc = netstat -ano | Select-String ':5000 .*LISTENING'; if ($proc) { $pid = ($proc -split '\\s+')[-1].Trim(); taskkill /F /PID $pid }\"",
    "predev": "npm run kill-port",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
